# Base URL del backend de Nexit (.NET). Localmente, corriendo el backend con
# ASPNETCORE_ENVIRONMENT=Production, escucha en este puerto y ya habla contra
# la base de datos real de Supabase en la nube -- ver Nexit_Back/docs/README.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5031

# Proyecto de Supabase (mismo backend/base de datos). El frontend los usa SOLO
# para lo que Supabase Auth maneja directo (login con código, recuperar
# contraseña) -- ver src/lib/supabase-client.ts y Nexit_Back/docs/10.
# La URL no es secreta. La anon/public key SÍ es específica del proyecto pero
# está pensada para exponerse en el navegador -- NUNCA uses la Service Role Key acá.
# Sacar ambas de: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
